# =============================================================================
# Daily Habit Tracker — environment template
# Copy to .env.local and fill in values:
#   cp .env.example .env.local
# =============================================================================

# --- Required: Database ---
MONGODB_URI=mongodb://localhost:27017/habit-tracker

# --- Required: Auth & encryption (min 32 chars each) ---
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_JWT_SECRET=
ENCRYPTION_KEY=

# --- Admin first-time setup (min 16 chars; NOT your login password) ---
# Web: /admin/setup  |  CLI: npm run bootstrap-admin
# Clear all admins: npm run clear-admin  (requires this token)
ADMIN_SETUP_TOKEN=

# Optional shared token for manually invoked WhatsApp summary/reminder API routes.
CRON_SECRET=

# --- Runtime ---
NODE_ENV=development

# --- WhatsApp Python server ---
WHATSAPP_PROVIDER=whatsapp-web
WHATSAPP_SERVER_HOST=127.0.0.1
WHATSAPP_SERVER_PORT=8000
WHATSAPP_SERVER_URL=http://127.0.0.1:8000
ADMIN_ID=admin
WA_CLIENT_TIMEOUT_MS=120000

WHATSAPP_BROWSER=chrome
WHATSAPP_HEADLESS=true
WHATSAPP_SESSION_DIR=./whatsapp_sessions/admin
NODEJS_API_URL=http://127.0.0.1:3000/api/admin/whatsapp/session

# --- Optional: Twilio ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=
